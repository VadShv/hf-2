11\u0435\u0437\u0443\u0441\u043b\u043e\u0432\u043d\u044b\u0439 \u043b\u0438\u0434\u0435\u0440 \u043d\u0430 \u0440\u044b\u043d\u043a\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0439 \u0420\u0424.  \u0422\u043e\u043f 10 \u043e\u0442\u0440\u0430\u0441\u043b\u0438. 5000+ \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432. \u0428\u0438\u0440\u043e\u043a\u0430\u044f \u0444\u0438\u043b\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0435\u0442\u044c. \u041e\u0444\u0438\u0441\u044b \u0432 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u0445 \u0441\u0442\u0440\u0430\u043d\u0430\u0445 \u043c\u0438\u0440\u0430. \u0421\u0430\u043c\u044b\u0439 \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u043f\u043e\u0440\u0442\u0444\u0435\u043b\u044c \u0443\u0441\u043b\u0443\u0433 \u0438 \u0441\u0435\u0440\u0432\u0438\u0441\u043e\u0432 \u043d\u0430 \u0440\u044b\u043d\u043a\u0435.\n\n\u0422\u0440\u0443\u0434\u043e\u0432\u0430\u044f \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c:\n\u0412 \u0437\u043e\u043d\u0435 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u0442\u0440\u0438 \u043e\u0442\u0434\u0435\u043b\u0430 \u043f\u0440\u043e\u0434\u0430\u0436 (SMB, EPG, \u0421\u041a\u0424\u041e), \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0440\u0435\u0441\u0435\u0439\u043b\u044b, \u043f\u0440\u043e\u0434\u0430\u043a\u0442 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u044b, \u043c\u0430\u0440\u043a\u0435\u0442\u043e\u043b\u043e\u0433\u0438.\n\u0412 \u0444\u043e\u043a\u0443\u0441\u0435 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043a\u0440\u0443\u043f\u043d\u044b\u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u044b \u0432 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u044f\u0445, \u043f\u0440\u043e\u0434\u0430\u0436\u0430 \u0438 \u0432\u043d\u0435\u0434\u0440\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u043e\u0433\u043e \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u044f, \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u043e\u0433\u043e \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044f, \u043e\u0440\u0433. \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u0438 \u0443\u0441\u043b\u0443\u0433 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u0438\u043c \u0438 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f\u043c. \u0422\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u044f: \u0420\u043e\u0441\u0442\u043e\u0432-\u043d\u0430-\u0414\u043e\u043d\u0443, \u0421\u0442\u0430\u0432\u0440\u043e\u043f\u043e\u043b\u044c \u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043d\u043e\u0432\u0430\u044f \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u044f - \u0421\u0435\u0432\u0435\u0440\u043d\u044b\u0439 \u041a\u0430\u0432\u043a\u0430\u0437.\n\u0412 \u0437\u043e\u043d\u0435 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0434\u0431\u043e\u0440 \u043d\u043e\u0432\u044b\u0445 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u043e\u0432 \u043f\u043e \u043f\u0440\u043e\u0434\u0430\u0436\u0430\u043c, \u043d\u0430\u0441\u0442\u0430\u0432\u043d\u0438\u0447\u0435\u0441\u0442\u0432\u043e, \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u043b\u0438\u0447\u043d\u044b\u043c \u043f\u0440\u0438\u043c\u0435\u0440\u043e\u043c \u0442\u0435\u0445\u043d\u0438\u043a\u0430\u043c \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u043f\u0440\u043e\u0434\u0430\u0436, \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043d\u044b\u043c \u043f\u0440\u043e\u0434\u0430\u0436\u0430\u043c, \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0437\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435\u043c \u043f\u043b\u0430\u043d\u0430 \u043f\u0440\u043e\u0434\u0430\u0436, \u0440\u0430\u0431\u043e\u0442\u0430 \u0441 \u0432\u043e\u0440\u043e\u043d\u043a\u043e\u0439 \u043f\u0440\u043e\u0434\u0430\u0436.\n\u041b\u0438\u0447\u043d\u044b\u0435 \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u043e\u0432 \u0438 \u0443\u0441\u043b\u0443\u0433 \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u044f\u043c, \u043f\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u044b \u0441 \u043f\u0435\u0440\u0432\u044b\u043c\u0438 \u043b\u0438\u0446\u0430\u043c\u0438, \u0433\u043b\u0430\u0432\u0430\u043c\u0438 \u043c\u0438\u043d\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432 \u0438 \u0433\u043b\u0430\u0432\u0430\u043c\u0438 \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a \u0421\u041a\u0424\u041e, \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u0438 \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u043e\u0432, \u0437\u043d\u0430\u0447\u0438\u043c\u044b\u0435 \u0441\u0434\u0435\u043b\u043a\u0438 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u043d\u0430 \u0432\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0438.\n\u041f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0440\u0430\u0431\u043e\u0442\u0430 \u043f\u043e \u0430\u043a\u0430\u0443\u043d\u0442 \u043b\u0438\u0441\u0442\u0443 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u043d\u043e \u0441 \u043a\u0440\u0443\u043f\u043d\u0435\u0439\u0448\u0438\u043c\u0438 \u0432\u0435\u043d\u0434\u043e\u0440\u0430\u043c\u0438 \u043e\u0442\u0440\u0430\u0441\u043b\u0438, \u0442\u0430\u043a\u0438\u043c\u0438 \u043a\u0430\u043a Microsoft, HP, Cisco, Fujitsu, Dell, Epson, Kaspersky, Aquarius, Usergate \u0438 \u0434\u0440.\n\u041f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0445 \u043c\u0430\u0440\u043a\u0435\u0442\u0438\u043d\u0433\u043e\u0432\u044b\u0445 \u043c\u0435\u0440\u043e\u043f\u0440\u0438\u044f\u0442\u0438\u044f\u0445. \u0412\u044b\u0435\u0437\u0434\u043d\u044b\u0435 \u043a\u043e\u043d\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0438. \u041f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e\u0435 \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0440\u0430\u0431\u043e\u0442\u0435 \u043a\u043b\u0443\u0431\u0430 \u0418\u0422 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u043e\u0432 \u042e\u0433\u0430 \u0420\u043e\u0441\u0438\u0438\u0438 \u0432 \u0446\u0435\u043b\u044f\u0445 \u043f\u0440\u043e\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438.\n\n\u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f:\n- \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0430 \u043f\u0440\u043e\u0434\u0430\u0436 \u0432\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u043c\u0438 \u043f\u043e\u0434\u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u043f\u043e \u0434\u0430\u043d\u043d\u044b\u043c \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u044f\u043c 105-110% \u0435\u0436\u0435\u0433\u043e\u0434\u043d\u043e;\n- \u0443\u0434\u043e\u0441\u0442\u043e\u0435\u043d \u0433\u0440\u0430\u043c\u043e\u0442\u044b \u00ab\u041e\u0442\u043a\u0440\u044b\u0442\u0438\u0435 \u0433\u043e\u0434\u0430\u00bb  2012\u0433;\n- \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u043f\u0435\u0440\u0432\u043e\u0439 \u0440\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u043d\u0441\u043a\u043e\u0439 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u04