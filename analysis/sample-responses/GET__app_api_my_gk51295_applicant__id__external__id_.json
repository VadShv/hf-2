43\u044e \u0432 \u0444\u0435\u0434\u0435\u0440\u0430\u043b\u044c\u043d\u044b\u0445 \u0432\u044b\u0441\u0442\u0430\u0432\u043a\u0430\u0445, \u043f\u0440\u0435\u0437\u0435\u043d\u0442\u0430\u0446\u0438\u044f\u0445, \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e \u0441 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u043a\u043e\u0439 \u0441\u0435\u0442\u044c\u044e, \u0430 \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u044c \u0432\u0440\u0435\u043c\u0435\u043d\u0438 - \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0441 \u043a\u043e\u043d\u0435\u0447\u043d\u044b\u043c\u0438 \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0430\u043c\u0438.  \u041d\u0435\u043f\u0440\u0435\u0440\u044b\u0432\u043d\u043e \u043e\u0431\u0443\u0447\u0430\u044e\u0441\u044c \u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u0441\u0442\u0432\u0443\u044e  \u0437\u043d\u0430\u043d\u0438\u044f. \n\u0423\u0432\u0435\u043b\u0438\u0447\u0438\u0432\u0430\u044e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u044f\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0413\u0440\u0430\u0432\u0438\u0442\u043e\u043d \u0432 \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0430\u0445. \u0420\u0430\u0437\u0432\u0438\u0432\u0430\u044e \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0446\u0438\u0438 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0430 \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u043e\u0432 \u043f\u043e \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0430\u043c \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438, \u0432\u044b\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044e \u043a\u0430\u043d\u0430\u043b \u043f\u0440\u043e\u0434\u0430\u0436 \u043d\u0430 \u0432\u0441\u0435\u0445 \u0443\u0440\u043e\u0432\u043d\u044f\u0445 (\u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0442\u043e\u0440, \u043f\u0430\u0440\u0442\u043d\u0435\u0440, \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a).\n\n\u041e\u0431\u043b\u0430\u0434\u0430\u0442\u0435\u043b\u044c \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0446\u0438\u0439 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u0440\u043e\u0434\u0430\u0436, \u043f\u043e\u0441\u0442\u0440\u043e\u0435\u043d\u0438\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u043f\u0440\u043e\u0434\u0430\u0436, \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432 \u043f\u0440\u043e\u0434\u0430\u0436  \u0432 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0445. \u0421\u0444\u0435\u0440\u0430 B2B, B2G. \u0423\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u043d\u044b\u0435 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0437\u043d\u0430\u043d\u0438\u044f (\u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 15+ \u043b\u0435\u0442) \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 44/223 \u0444\u0437. \u041f\u0435\u0440\u0435\u0433\u043e\u0432\u043e\u0440\u044b \u043d\u0430 \u043b\u044e\u0431\u044b\u0445 \u0443\u0440\u043e\u0432\u043d\u044f\u0445 \u043e\u0442 \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0445 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432 \u0434\u043e \u043f\u0435\u0440\u0432\u044b\u0445 \u043b\u0438\u0446 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0439 \u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432, C-level. \n\n\u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f:\n- \u0443\u0433\u043b\u0443\u0431\u043b\u0435\u043d\u043d\u043e\u0435 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u043d\u0438\u043c\u0430\u043d\u04